{
    "name": "strukt/fs",
    "description": "Filesystem",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Strukt\\": "src/Strukt"
        },
        "files":["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require":{
        "strukt/base":"dev-changes",
        "ext-zip": "*"
    },
    "require-dev": {
        "mikey179/vfsstream": "^1.6",
        "pestphp/pest": "4.x-dev",
        "symfony/var-dumper": "6.4.x-dev"
    },
    "authors": [
        {
            "name": "pitsolu",
            "email": "pitsolu@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "repositories": [
        {
            "type": "path",
            "url": "../base",
            "options": {
                "symlink": false
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
